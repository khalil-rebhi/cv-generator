{
  "name": "cv-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Générateur de CV au format ITEC (Word .docx) avec aperçu en temps réel",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "tsc --noEmit",
    "template": "node scripts/build-template.mjs",
    "sample": "tsx scripts/render-sample.ts"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "docx-preview": "0.4.1",
    "docxtemplater": "3.71.1",
    "next": "15.5.29",
    "pizzip": "3.3.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "7.91.0"
  },
  "devDependencies": {
    "@types/node": "20.19.13",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@xmldom/xmldom": "0.9.12",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}
